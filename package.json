{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "glimpse",
  "version": "0.15.1",
  "description": "A lightweight, git-native desktop Git client — the full branch graph, diffs, and everyday git, with first-class WSL support.",
  "keywords": [
    "diff-viewer",
    "git",
    "git-client",
    "git-graph",
    "kirchdev",
    "nuxt",
    "tauri",
    "vue",
    "wsl"
  ],
  "homepage": "https://github.com/TitusKirch/glimpse#readme",
  "bugs": {
    "url": "https://github.com/TitusKirch/glimpse/issues"
  },
  "license": "MIT",
  "author": "Titus Kirch <titus.kirch@kirch.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TitusKirch/glimpse.git"
  },
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "tauri": "tauri",
    "tauri:build": "tauri build --config src-tauri/tauri.sidecar.conf.json",
    "cli:sidecar": "node scripts/build-cli-sidecar.ts",
    "cli:wsl-payload": "node scripts/build-wsl-payload.ts",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml -p glimpse-core --lib export_bindings -- --ignored && oxfmt app/types/bindings.ts",
    "test": "vitest run",
    "e2e": "wdio run tests/e2e/wdio.conf.ts",
    "perf:baseline": "node scripts/perf-baseline.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "nuxt typecheck && vue-tsc -p tests/e2e/tsconfig.json && vue-tsc -p tsconfig.tooling.json",
    "cargofmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "cargofmt:fix": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm cargofmt && pnpm test",
    "check:fix": "pnpm lint:fix && pnpm format:fix && pnpm cargofmt:fix",
    "taze": "taze",
    "taze:w": "taze -w",
    "cargo:update": "cargo update --manifest-path src-tauri/Cargo.toml",
    "cargo:outdated": "cargo upgrade --manifest-path src-tauri/Cargo.toml --incompatible --dry-run",
    "cargo:upgrade": "cargo upgrade --manifest-path src-tauri/Cargo.toml --incompatible",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/vue-form": "^1.33.5",
    "@tanstack/vue-virtual": "^3.13.40",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.2",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.12.0",
    "nuxt": "4.5.2",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.43",
    "vue-sonner": "^2.0.9",
    "vuedraggable": "^4.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@iconify-json/flag": "^1.2.12",
    "@iconify-json/lucide": "^1.2.142",
    "@iconify-json/simple-icons": "^1.2.99",
    "@nuxt/icon": "^2.5.1",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/test-utils": "^2.5.1",
    "@wdio/cli": "^10.0.2",
    "@wdio/globals": "^10.0.2",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.72.0",
    "oxlint": "^1.87.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "shadcn-nuxt": "^2.8.2",
    "taze": "^21.3.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.1"
}
