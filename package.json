{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "glimpse",
  "version": "0.11.0",
  "description": "A lightweight, git-native desktop Git client — the full branch graph, diffs, and everyday git, with first-class WSL support.",
  "keywords": [
    "diff-viewer",
    "git",
    "git-client",
    "git-graph",
    "kirchdev",
    "nuxt",
    "tauri",
    "vue",
    "wsl"
  ],
  "homepage": "https://github.com/TitusKirch/glimpse#readme",
  "bugs": {
    "url": "https://github.com/TitusKirch/glimpse/issues"
  },
  "license": "MIT",
  "author": "Titus Kirch <titus.kirch@kirch.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TitusKirch/glimpse.git"
  },
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "tauri": "tauri",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml --lib export_bindings -- --ignored && oxfmt app/types/bindings.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "cargofmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "cargofmt:fix": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "check": "pnpm lint && pnpm format && pnpm cargofmt",
    "check:fix": "pnpm lint:fix && pnpm format:fix && pnpm cargofmt:fix",
    "taze": "taze",
    "taze:w": "taze -w",
    "cargo:update": "cargo update --manifest-path src-tauri/Cargo.toml",
    "cargo:outdated": "cargo upgrade --manifest-path src-tauri/Cargo.toml --incompatible --dry-run",
    "cargo:upgrade": "cargo upgrade --manifest-path src-tauri/Cargo.toml --incompatible",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/vue-form": "^1.33.0",
    "@tanstack/vue-virtual": "^3.13.28",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.4.2",
    "highlight.js": "^11.11.1",
    "nuxt": "^4.4.8",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.10",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.38",
    "vue-sonner": "^2.0.9",
    "vuedraggable": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@iconify-json/flag": "^1.2.12",
    "@iconify-json/lucide": "^1.2.112",
    "@iconify-json/simple-icons": "^1.2.86",
    "@nuxt/icon": "^2.2.3",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.4.0",
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.11.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "4.1.9",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "shadcn-nuxt": "^2.7.4",
    "taze": "^19.14.1",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.2.2"
}
