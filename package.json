{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "glimpse",
  "version": "0.0.0",
  "description": "Lightweight, git-native desktop Git client — branch graph & diffs with first-class WSL support.",
  "keywords": [
    "diff-viewer",
    "git",
    "git-client",
    "git-graph",
    "kirchdev",
    "nuxt",
    "tauri",
    "vue",
    "wsl"
  ],
  "homepage": "https://github.com/TitusKirch/glimpse#readme",
  "bugs": {
    "url": "https://github.com/TitusKirch/glimpse/issues"
  },
  "license": "MIT",
  "author": "Titus Kirch <titus.kirch@kirch.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TitusKirch/glimpse.git"
  },
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "tauri": "tauri",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml --lib export_bindings -- --ignored && oxfmt app/types/bindings.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "check": "pnpm lint && pnpm format",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "taze": "taze",
    "taze:w": "taze -w",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "nuxt": "^4.4.6",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.35",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@iconify-json/flag": "^1.2.12",
    "@iconify-json/lucide": "^1.2.110",
    "@iconify-json/simple-icons": "^1.2.84",
    "@nuxt/icon": "^2.2.2",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "shadcn-nuxt": "^2.7.3",
    "taze": "^19.13.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.2.2"
}
