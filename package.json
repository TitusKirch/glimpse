{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "glimpse",
  "version": "0.0.0",
  "description": "Ultra-lightweight, passive Git diff & graph viewer built for developers who pair with terminal AI agents.",
  "keywords": [
    "ai-agent",
    "diff-viewer",
    "git",
    "git-graph",
    "kirchdev",
    "nuxt",
    "review",
    "tauri",
    "vue"
  ],
  "homepage": "https://github.com/TitusKirch/glimpse#readme",
  "bugs": {
    "url": "https://github.com/TitusKirch/glimpse/issues"
  },
  "license": "MIT",
  "author": "Titus Kirch <titus.kirch@kirch.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TitusKirch/glimpse.git"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "check": "pnpm lint && pnpm format",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "taze": "taze",
    "taze:w": "taze -w",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "oxfmt": "0.52.0",
    "oxlint": "1.67.0",
    "taze": "^19.14.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.2.2"
}
