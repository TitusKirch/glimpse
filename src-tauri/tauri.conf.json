{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "glimpse",
  "version": "0.0.0",
  "identifier": "dev.kirch.glimpse",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm generate"
  },
  "app": {
    "windows": [
      {
        "title": "glimpse",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["glimpse"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/TitusKirch/glimpse/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwREM4QkY2RTgzOEJBOTAKUldTUXVqam85b3Zjc0VwQWdRbU9zb0l0b3JYTEpzL1RzSEU0UmlqejBwZkZBVnNWbGtHNVRaSTUK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
