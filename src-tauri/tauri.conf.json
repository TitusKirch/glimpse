{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "glimpse",
  "version": "0.4.0",
  "identifier": "dev.kirch.glimpse",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm generate"
  },
  "app": {
    "windows": [
      {
        "title": "glimpse",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://api.iconify.design https://api.simplesvg.com https://api.unisvg.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "cli": {
      "description": "glimpse — a lightweight, git-native desktop Git client",
      "args": [
        {
          "name": "path",
          "index": 1,
          "takesValue": true,
          "description": "Path to a git repository to open (defaults to the current directory)"
        }
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "glimpse"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/TitusKirch/glimpse/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwREM4QkY2RTgzOEJBOTAKUldTUXVqam85b3Zjc0VwQWdRbU9zb0l0b3JYTEpzL1RzSEU0UmlqejBwZkZBVnNWbGtHNVRaSTUK"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "app"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
